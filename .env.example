# Database
DATABASE_URL=postgresql://user:password@localhost:5432/packsmart_db

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backend
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=PackSmart AI

# PostgreSQL (for Docker)
POSTGRES_USER=packsmart
POSTGRES_PASSWORD=packsmart_password
POSTGRES_DB=packsmart_db
